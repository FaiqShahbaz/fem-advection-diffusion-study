{
  "purpose": "Transient P1/P2 spatial verification at T=1 with time, quadrature and solver controls; no cost or temporal-order claim",
  "mesh_subdivisions": [
    8,
    16,
    32
  ],
  "mesh_diagonal": "left",
  "element_family": "CG",
  "velocity": [
    1.0,
    1.0
  ],
  "diffusion": 1.0,
  "dt": 0.005,
  "quadrature_degree": 10,
  "solver_parameters": {
    "snes_type": "ksponly",
    "ksp_type": "gmres",
    "pc_type": "jacobi",
    "ksp_pc_side": "right",
    "ksp_norm_type": "unpreconditioned",
    "ksp_rtol": 1e-11,
    "ksp_atol": 1e-13,
    "ksp_max_it": 200,
    "ksp_gmres_restart": 50,
    "ksp_error_if_not_converged": true,
    "ksp_initial_guess_nonzero": false
  },
  "checks": {
    "source_residual_l2_max": 1e-10,
    "boundary_trace_l2_max": 1e-12,
    "residual_tolerance_factor": 10.0,
    "tableau_coefficient_atol": 1e-14,
    "update_identity_l2_max": 1e-12,
    "stiff_accuracy_l2_max": 1e-12,
    "stage_boundary_trace_l2_max": 1e-12,
    "domain_area_atol": 1e-12,
    "analytic_norm_rtol": 1e-10,
    "analytic_norm_atol": 1e-12,
    "quadrature_comparison_rtol": 1e-06,
    "quadrature_comparison_atol": 1e-13,
    "observed_order_atol": 0.4,
    "time_control_fraction": 0.05,
    "solver_control_fraction": 0.01,
    "field_control_atol": 1e-12,
    "initial_baseline_rtol": 1e-09,
    "initial_baseline_atol": 1e-12
  },
  "time_method": "RadauIIA",
  "num_stages": 2,
  "stage_type": "deriv",
  "bc_type": "DAE",
  "splitting": "AI",
  "tableau_rational": {
    "A": [
      [
        "5/12",
        "-1/12"
      ],
      [
        "3/4",
        "1/4"
      ]
    ],
    "b": [
      "3/4",
      "1/4"
    ],
    "c": [
      "1/3",
      "1"
    ]
  },
  "element_degrees": [
    1,
    2
  ],
  "final_time": 1.0,
  "control_dt": 0.0025,
  "quadrature_control_degree": 14,
  "solver_control": {
    "element_degree": 2,
    "mesh_subdivisions": 32,
    "tolerance_factor": 0.1
  },
  "expected_orders": {
    "1": {
      "l2_error": 2.0,
      "h1_seminorm_error": 1.0
    },
    "2": {
      "l2_error": 3.0,
      "h1_seminorm_error": 2.0
    }
  }
}
