{
  "purpose": "One-step two-stage Radau IIA coupled-equation/update teaching check; not a convergence or timing study",
  "mesh_subdivisions": 8,
  "mesh_diagonal": "left",
  "element_family": "CG",
  "element_degree": 1,
  "velocity": [
    1.0,
    1.0
  ],
  "diffusion": 1.0,
  "dt": 0.01,
  "steps": 1,
  "quadrature_degree": 10,
  "solver_parameters": {
    "snes_type": "ksponly",
    "ksp_type": "gmres",
    "pc_type": "jacobi",
    "ksp_pc_side": "right",
    "ksp_norm_type": "unpreconditioned",
    "ksp_rtol": 1e-11,
    "ksp_atol": 1e-13,
    "ksp_max_it": 200,
    "ksp_gmres_restart": 50,
    "ksp_error_if_not_converged": true,
    "ksp_initial_guess_nonzero": false
  },
  "checks": {
    "source_residual_l2_max": 1e-10,
    "boundary_trace_l2_max": 1e-12,
    "residual_tolerance_factor": 10.0,
    "serial_mpi_comparison_rtol": 1e-09,
    "serial_mpi_comparison_atol": 1e-12,
    "tableau_coefficient_atol": 1e-14,
    "update_identity_l2_max": 1e-12,
    "stiff_accuracy_l2_max": 1e-12,
    "stage_boundary_trace_l2_max": 1e-12
  },
  "time_method": "RadauIIA",
  "num_stages": 2,
  "stage_type": "deriv",
  "bc_type": "DAE",
  "splitting": "AI",
  "tableau_rational": {
    "A": [
      [
        "5/12",
        "-1/12"
      ],
      [
        "3/4",
        "1/4"
      ]
    ],
    "b": [
      "3/4",
      "1/4"
    ],
    "c": [
      "1/3",
      "1"
    ]
  }
}
